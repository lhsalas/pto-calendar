# Server
NODE_ENV=development
PORT=3000

# Session
# SESSION_SECRET: generate with `openssl rand -base64 32`. Must be >=32 chars,
# must not be a known placeholder string, and must have high entropy.
# Multiple comma-separated values are supported for graceful key rotation
# (the new key signs, older keys verify). All values are validated.
SESSION_SECRET=REPLACE-ME-generate-with-openssl-rand-base64-32-and-paste-here
COOKIE_SECURE=false
COOKIE_DOMAIN=
# Use `none` when the browser frontend and API are on different HTTPS sites
# (for example Firebase Hosting + Cloud Run). SameSite=None requires Secure.
COOKIE_SAME_SITE=lax
COOKIE_MAX_AGE_MS=86400000

# Database
DATABASE_URL=postgresql://pto:pto@localhost:5432/pto?schema=public

# Bootstrap (production first-run; see `npm run db:bootstrap`)
# LEAD_EMAIL is required for `npm run db:bootstrap`. LEAD_NAME,
# LEAD_COLOR_CODE, and APP_PUBLIC_BASE_URL are optional (defaults shown).
# The script creates a team_lead user with a one-time setup link printed
# to stdout; idempotent: if the lead already has a password, it's a no-op.
# LEAD_EMAIL=lead@yourcompany.com
# LEAD_NAME=Team Lead
# LEAD_COLOR_CODE=#3B82F6
# APP_PUBLIC_BASE_URL=http://localhost:5173

# Auth
# BCRYPT_ROUNDS: hashing cost for new passwords (4 in test, 10 minimum in production).
BCRYPT_ROUNDS=10

# How long requireAuth caches the live (id, role) record for a session user
# before re-querying the DB. Tuned to bound cost per request while still
# picking up role changes / deletions within a few seconds.
AUTH_USER_CACHE_TTL_MS=15000

# Number of reverse-proxy hops to trust when reading X-Forwarded-For.
# Set this to the count of proxies in front of the API. Cloud Run uses 1;
# the OCI Caddy -> nginx -> backend stack uses 2. Default 0 in dev/test.
# The Express rate limiters and req.ip use this to derive the real client IP.
# Spoofing is prevented when this is 0 (X-Forwarded-For is ignored).
TRUST_PROXY_HOPS=0

# CORS
CORS_ORIGIN=http://localhost:5173

# Logging
LOG_LEVEL=info

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=5
# Required in production for a shared limiter across instances.
# Use the existing Upstash TLS URL (`rediss://...`). Leave unset in dev/test.
# RATE_LIMIT_REDIS_URL=rediss://:password@redis.example.com:6379/0

# Shutdown
SHUTDOWN_TIMEOUT_MS=10000

# Readiness
READY_TIMEOUT_MS=5000

# Insecure cookies (DEVELOPMENT DEMO ONLY)
# INSECURE_COOKIES_ALLOWED is accepted only outside production for the
# HTTP-only `npm run app:up` all-in-one compose stack (no TLS termination,
# plain HTTP). Production rejects this flag regardless of COOKIE_SECURE.
# INSECURE_COOKIES_ALLOWED=false

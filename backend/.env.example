# Server
NODE_ENV=development
PORT=3000

# Session
SESSION_SECRET=replace-me-with-a-long-random-string-min-32-chars
COOKIE_SECURE=false
COOKIE_DOMAIN=
COOKIE_MAX_AGE_MS=86400000

# Database
DATABASE_URL=postgresql://pto:pto@localhost:5432/pto?schema=public

# Auth
BCRYPT_ROUNDS=10

# CORS
CORS_ORIGIN=http://localhost:5173

# Logging
LOG_LEVEL=info

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=5
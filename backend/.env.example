# Server
NODE_ENV=development
PORT=3000

# Session
# SESSION_SECRET: generate with `openssl rand -base64 32`. Must be >=32 chars,
# must not be a known placeholder string, and must have high entropy.
# Multiple comma-separated values are supported for graceful key rotation
# (the new key signs, older keys verify). All values are validated.
SESSION_SECRET=REPLACE-ME-generate-with-openssl-rand-base64-32-and-paste-here
COOKIE_SECURE=false
COOKIE_DOMAIN=
# Use `none` when the browser frontend and API are on different HTTPS sites
# rather than the supported OCI single-host topology. None requires Secure.
COOKIE_SAME_SITE=lax
COOKIE_MAX_AGE_MS=86400000

# Database
DATABASE_URL=postgresql://pto:pto@localhost:5432/pto?schema=public

# Bootstrap (production first-run; see `npm run db:bootstrap`)
# LEAD_EMAIL is required for `npm run db:bootstrap`. LEAD_NAME,
# LEAD_COLOR_CODE, and APP_PUBLIC_BASE_URL are optional (defaults shown).
# The script creates a team_lead user with a one-time setup link printed
# to stdout; idempotent: if the lead already has a password, it's a no-op.
# LEAD_EMAIL=lead@yourcompany.com
# LEAD_NAME=Team Lead
# LEAD_COLOR_CODE=#3B82F6
# APP_PUBLIC_BASE_URL=http://localhost:5173

# Auth
# BCRYPT_ROUNDS: hashing cost for new passwords (4 in test, 10 minimum in production).
BCRYPT_ROUNDS=10

# How long requireAuth caches the live (id, role) record for a session user
# before re-querying the DB. Tuned to bound cost per request while still
# picking up role changes / deletions within a few seconds.
AUTH_USER_CACHE_TTL_MS=15000

# Personal-token rollout: strict explicit opt-in, both off in every environment.
# Test flags only until audit, quotas and the separate rollout gates pass.
PAT_AUTH_ENABLED=false
PAT_WRITES_ENABLED=false

# Number of reverse-proxy hops to trust when reading X-Forwarded-For.
# Set this to the count of proxies in front of the API. The supported
# OCI Caddy -> nginx -> backend stack uses 2. Default 0 in dev/test.
# The Express rate limiters and req.ip use this to derive the real client IP.
# Spoofing is prevented when this is 0 (X-Forwarded-For is ignored).
TRUST_PROXY_HOPS=0

# CORS
CORS_ORIGIN=http://localhost:5173

# Logging
LOG_LEVEL=info

# Rate limiting
# RATE_LIMIT_WINDOW_MS: the window of the shared/unauthenticated budgets
# (global IP high-water and failed browser logins).
RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX: the emergency high-water for one client address. It is the
# first ceiling every request meets, so an office behind one shared address
# consumes it together. It stays conservative; raise it explicitly when the
# per-caller budgets below should be the binding limit for a shared address.
RATE_LIMIT_MAX=100
# AUTH_RATE_LIMIT_MAX: failed browser logins per client address and window.
AUTH_RATE_LIMIT_MAX=5
# RATE_LIMIT_ATTEMPT_WINDOW_MS: the attempt window of the personal-token
# controls (failed bearer verifications, token issuance and the issuance
# password check). Bounded to 1 second .. 24 hours.
RATE_LIMIT_ATTEMPT_WINDOW_MS=900000
# RATE_LIMIT_BEARER_FAILURE_MAX: failed personal-token verifications per
# client address and attempt window. The attempt is charged before the
# credential lookup and a verified secret is refunded, so a shared office
# address does not lock out its legitimate users.
RATE_LIMIT_BEARER_FAILURE_MAX=20
# RATE_LIMIT_QUOTA_WINDOW_MS: the sustained-traffic window for the verified
# per-user and per-token quotas.
RATE_LIMIT_QUOTA_WINDOW_MS=60000
# RATE_LIMIT_USER_QUOTA_MAX: authenticated requests per verified user and
# quota window.
RATE_LIMIT_USER_QUOTA_MAX=600
# RATE_LIMIT_TOKEN_QUOTA_MAX: authenticated requests per verified personal
# token and quota window.
RATE_LIMIT_TOKEN_QUOTA_MAX=300
# RATE_LIMIT_TOKEN_ISSUANCE_MAX: token creations per verified owner and
# attempt window. It stays above the ten active tokens per owner.
RATE_LIMIT_TOKEN_ISSUANCE_MAX=20
# RATE_LIMIT_TOKEN_PASSWORD_MAX: issuance password verifications per verified
# owner and attempt window. It is charged before the bcrypt comparison and is
# not given back, so it bounds the expensive comparisons themselves. It is
# separate from the browser login budget.
RATE_LIMIT_TOKEN_PASSWORD_MAX=20
# Required in production for a shared limiter across instances.
# Use the existing Upstash TLS URL (`rediss://...`). Leave unset in dev/test.
# RATE_LIMIT_REDIS_URL=rediss://:password@redis.example.com:6379/0

# Shutdown
SHUTDOWN_TIMEOUT_MS=10000

# Readiness
READY_TIMEOUT_MS=5000

# Insecure cookies (DEVELOPMENT DEMO ONLY)
# INSECURE_COOKIES_ALLOWED is accepted only outside production for the
# HTTP-only `npm run app:up` all-in-one compose stack (no TLS termination,
# plain HTTP). Production rejects this flag regardless of COOKIE_SECURE.
# INSECURE_COOKIES_ALLOWED=false

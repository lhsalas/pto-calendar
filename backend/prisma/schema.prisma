generator client {
  provider        = "prisma-client-js"
  previewFeatures = []
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  member
  team_lead
  admin
}

enum DayPart {
  morning
  evening
  all_day
}

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  name               String    @db.VarChar(120)
  email              String    @unique @db.VarChar(255)
  role               Role
  colorCode          String    @map("color_code") @db.VarChar(20)
  passwordHash       String?   @map("password_hash")
  setupTokenHash     String?   @map("setup_token_hash") @db.VarChar(64)
  setupTokenExpiresAt DateTime? @map("setup_token_expires_at")
  sessionVersion     Int       @default(0) @map("session_version")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  ptoRequests PTORequest[]
  auditLogs   AuditLog[]   @relation("AuditActor")
  holidays    Holiday[]    @relation("HolidayCreator")

  @@map("users")
}

model PTORequest {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  startDate DateTime @db.Date @map("start_date")
  endDate   DateTime @db.Date @map("end_date")
  dayPart   DayPart  @map("day_part")
  note      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([startDate])
  @@index([endDate])
  @@index([startDate, endDate])
  @@map("pto_requests")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String   @map("actor_user_id") @db.Uuid
  action      String   @db.VarChar(50)
  entityType  String   @map("entity_type") @db.VarChar(50)
  entityId    String   @map("entity_id") @db.Uuid
  details     Json?
  createdAt   DateTime @default(now()) @map("created_at")

  actor User @relation("AuditActor", fields: [actorUserId], references: [id])

  @@index([actorUserId])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model Holiday {
  id          String   @id @default(uuid()) @db.Uuid
  date        DateTime @db.Date @map("date")
  name        String   @db.VarChar(120)
  countryCode String?  @map("country_code") @db.VarChar(2)
  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  createdBy User @relation("HolidayCreator", fields: [createdById], references: [id])

  @@unique([date, countryCode])
  @@index([date])
  @@map("holidays")
}

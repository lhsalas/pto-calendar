[Unit]
Description=PTO Calendar daily Postgres backup
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=deploy
Group=deploy
Environment=INSTALL_DIR=/opt/pto-calendar
Environment=BACKUP_DIR=/opt/backups
Environment=RETENTION_DAYS=7
ExecStart=/opt/pto-calendar/infra/deploy/backup.sh
WorkingDirectory=/opt/pto-calendar

# Hard cap so a hung pg_dump doesn't pin the timer forever.
TimeoutStartSec=1800

# Log to journald; the timer's Persistent=true makes missed runs catch up.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

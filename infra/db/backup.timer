[Unit]
Description=Daily PTO Calendar Postgres backup timer
Requires=backup.service

[Timer]
# Run daily at 03:00 UTC. UTC keeps the schedule independent of the host's
# timezone setting (OCI Ubuntu images default to UTC).
OnCalendar=*-*-* 03:00:00 UTC

# If the unit was down at the scheduled time (instance stopped, host
# suspended, journal replayed after boot), run once on next boot.
Persistent=true

# Randomize startup delay so multiple VMs pointed at the same Object
# Storage bucket don't all hammer the same S3 partition.
RandomizedDelaySec=300

[Install]
WantedBy=timers.target

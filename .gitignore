coverage/
# infra/coverage/ holds the #313 CI coverage-gate source (a parser and its
# tests), not generated coverage output, so it stays tracked.
!/infra/coverage/
# Python bytecode from the coverage-gate parser tests.
/infra/coverage/__pycache__/
.nyc_output/

.env
.env.local
.env.*.local

*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

.DS_Store
.idea/
.vscode/
*.swp
*.swo

backend/prisma/migrations/dev.db*

playwright-report/
test-results/

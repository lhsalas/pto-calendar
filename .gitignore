/backend/coverage/
/backend/coverage-unit/
/backend/dist/
/frontend/coverage/
/frontend/dist/
/frontend/dist-node/
/frontend/tsconfig.tsbuildinfo

# Local encrypted backup/restore artifacts. The source schema documentation is
# tracked under docs/schema.sql and is not affected by these root-only rules.
/pto-*.tar.gz
/pto-*.tar.gz.gpg
/pto-*.tar.gz.gpg.sha256
/schema.sql
/data.sql

*.tsbuildinfo

/security-reports/

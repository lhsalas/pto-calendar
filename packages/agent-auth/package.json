{
  "name": "@pto-calendar/agent-auth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local origin-bound credential profiles for PTO agent adapters",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.22.3",
    "npm": ">=10.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "libexec/secret-service.py",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format:check": "prettier --ignore-path ../../.gitignore --check \"**/*.{ts,js,json,md}\""
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.1.0"
  }
}

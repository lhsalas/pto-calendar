{
  "name": "@pto-calendar/api-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Runtime-neutral typed HTTP client for the PTO Calendar REST API (#259)",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.22.3",
    "npm": ">=10.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "npm run build:ts",
    "build:ts": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "format": "prettier --ignore-path ../../.gitignore --write \"**/*.{ts,js,json,md}\"",
    "format:check": "prettier --ignore-path ../../.gitignore --check \"**/*.{ts,js,json,md}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.0",
    "yaml": "2.9.1"
  }
}

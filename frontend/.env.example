# Local development can call the backend directly or use the Vite proxy.
# OCI production leaves the build-time API base empty for same-origin requests.
VITE_API_BASE_URL=http://localhost:3000

# Default per-request timeout in ms. apiRequest aborts the underlying fetch
# after this many ms and throws a typed ApiError(0, { code: 'TIMEOUT' }).
# Default 15000 (15s).
VITE_API_TIMEOUT_MS=15000

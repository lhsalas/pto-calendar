# Local development uses the Vite proxy. Production sets this to the public
# Cloud Run origin, for example https://pto-api-...a.run.app.
VITE_API_BASE_URL=http://localhost:3000

# Default per-request timeout in ms. apiRequest aborts the underlying fetch
# after this many ms and throws a typed ApiError(0, { code: 'TIMEOUT' }).
# Default 15000 (15s).
VITE_API_TIMEOUT_MS=15000
